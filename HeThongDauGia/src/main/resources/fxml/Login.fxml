<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            nodeOrientation="LEFT_TO_RIGHT" prefHeight="400.0" prefWidth="600.0"
            style="-fx-background-color: #F57D1F;"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.controllers.LoginController">
    <children>
        <ImageView fitHeight="400.0" fitWidth="610.0" layoutX="-5.0" opacity="0.1" pickOnBounds="true">
            <image>
                <Image url="@../images/360_F_203669387_m7IvXlkV0FQwA69Xpt8AwlAdO5Ih05Mc.jpg"/>
            </image>
        </ImageView>

        <VBox alignment="CENTER" layoutX="150.0" layoutY="10.0" prefWidth="300.0" spacing="8.0">
            <padding>
                <Insets top="5" bottom="5" left="20" right="20"/>
            </padding>
            <children>
                <ImageView fitHeight="98.0" fitWidth="182.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/Thiết%20kế%20chưa%20có%20tên.png"/>
                    </image>
                </ImageView>

                <Label alignment="CENTER" text="ĐĂNG NHẬP" textFill="#15110e">
                    <font>
                        <Font name="Calibri Bold" size="32.0"/>
                    </font>
                </Label>

                <TextField id="txtUsername" fx:id="txtUsername" promptText="Tên đăng nhập"
                           prefHeight="38.0" prefWidth="220.0">
                    <font>
                        <Font name="Calibri" size="12.0"/>
                    </font>
                </TextField>

                <PasswordField fx:id="txtPassword" promptText="Mật khẩu"
                               prefHeight="38.0" prefWidth="220.0">
                    <font>
                        <Font name="Calibri" size="12.0"/>
                    </font>
                </PasswordField>

                <Button fx:id="btnLogin" onAction="#handleLogin" prefHeight="30.0" prefWidth="143.0"
                        style="-fx-background-color: #FCBF49;" text="Đăng nhập">
                    <font>
                        <Font name="Calibri" size="15.0"/>
                    </font>
                </Button>

                <Hyperlink fx:id="linkRegister" onAction="#handleGoToRegister"
                           text="Chưa có tài khoản? Đăng ký ngay" textFill="#15110e">
                    <font>
                        <Font name="Calibri" size="13.0"/>
                    </font>
                </Hyperlink>
            </children>
        </VBox>
    </children>
</AnchorPane>
