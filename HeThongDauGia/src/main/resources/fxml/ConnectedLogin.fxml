<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.auction.client.controllers.ConnectedLoginController">
    <Region style="-fx-background-color: linear-gradient(to bottom right, #151515, #2A1608, #141414);" />

    <VBox alignment="CENTER" maxWidth="360.0" spacing="12.0"
          style="-fx-background-color: rgba(30,30,30,0.88); -fx-background-radius: 12; -fx-border-color: rgba(245,125,31,0.35); -fx-border-radius: 12; -fx-border-width: 1;">
        <padding>
            <Insets bottom="28" left="32" right="32" top="28" />
        </padding>

        <Label text="DANG NHAP SERVER" textFill="#FCBF49">
            <font>
                <Font name="System Bold" size="26.0" />
            </font>
        </Label>

        <TextField fx:id="txtUsername" promptText="Username"
                   style="-fx-background-color: rgba(255,255,255,0.08); -fx-text-fill: white; -fx-prompt-text-fill: #999999; -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.16); -fx-border-radius: 8;" />

        <TextField fx:id="txtEmail" promptText="Email"
                   style="-fx-background-color: rgba(255,255,255,0.08); -fx-text-fill: white; -fx-prompt-text-fill: #999999; -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.16); -fx-border-radius: 8;" />

        <PasswordField fx:id="txtPassword" promptText="Password"
                       style="-fx-background-color: rgba(255,255,255,0.08); -fx-text-fill: white; -fx-prompt-text-fill: #999999; -fx-background-radius: 8; -fx-border-color: rgba(255,255,255,0.16); -fx-border-radius: 8;" />

        <ComboBox fx:id="cboRole" maxWidth="Infinity"
                  style="-fx-background-radius: 8;" />

        <Button maxWidth="Infinity" onAction="#handleLogin" prefHeight="38.0"
                style="-fx-background-color: linear-gradient(to right, #F57D1F, #FCBF49); -fx-text-fill: #1A1A1A; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"
                text="Dang nhap" />

        <Button maxWidth="Infinity" onAction="#handleRegister" prefHeight="34.0"
                style="-fx-background-color: transparent; -fx-text-fill: #FCBF49; -fx-border-color: #F57D1F; -fx-border-radius: 8; -fx-background-radius: 8; -fx-cursor: hand;"
                text="Dang ky tai khoan moi" />
    </VBox>
</StackPane>
