<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="768.0" prefWidth="1366.0" style="-fx-background-color: #f0f2f5;" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controllers.MainController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="60.0" style="-fx-background-color: white; -fx-border-color: #e4e6eb; -fx-border-width: 0 0 1 0; -fx-padding: 0 20 0 20;" BorderPane.alignment="CENTER">
            <children>
                <ImageView fitHeight="45.0" fitWidth="90.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/Thiết%20kế%20chưa%20có%20tên.png"/>
                    </image>
                    <HBox.margin>
                        <Insets right="10.0"/>
                    </HBox.margin>
                </ImageView>
                <Label text="HỆ THỐNG ĐẤU GIÁ" textFill="#5c3a21">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>

                <Region HBox.hgrow="ALWAYS" />

                <Label fx:id="lblUserInfo" text="Xin chào, User">
                    <font>
                        <Font size="14.0" />
                    </font>
                    <HBox.margin>
                        <Insets right="20.0" />
                    </HBox.margin>
                </Label>
                <Button mnemonicParsing="false" onAction="#handleLogout" style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Đăng xuất">
                    <padding>
                        <Insets bottom="8.0" left="15.0" right="15.0" top="8.0" />
                    </padding>
                </Button>
            </children>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="240.0" spacing="5.0" style="-fx-background-color: white; -fx-border-color: #e4e6eb; -fx-border-width: 0 1 0 0; -fx-padding: 15 10 15 10;" BorderPane.alignment="CENTER">
            <children>
                <Button fx:id="btnAuctionList" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleShowAuctionList" style="-fx-background-color: #1877f2; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" text="🏠  Trang chủ / Danh sách Đấu giá">
                    <padding>
                        <Insets bottom="12.0" left="15.0" right="15.0" top="12.0" />
                    </padding>
                </Button>

                <Button fx:id="btnBidHistory" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleShowBidHistory" style="-fx-background-color: transparent; -fx-text-fill: #333333; -fx-font-size: 14px; -fx-cursor: hand;" text="🕒  Lịch sử Đấu giá">
                    <padding>
                        <Insets bottom="12.0" left="15.0" right="15.0" top="12.0" />
                    </padding>
                </Button>

                <Button fx:id="btnProductMgmt" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleShowProductMgmt" style="-fx-background-color: transparent; -fx-text-fill: #333333; -fx-font-size: 14px; -fx-cursor: hand;" text="📦  Quản lý Sản phẩm">
                    <padding>
                        <Insets bottom="12.0" left="15.0" right="15.0" top="12.0" />
                    </padding>
                </Button>

                <Button fx:id="btnUserMgmt" alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleShowUserMgmt" style="-fx-background-color: transparent; -fx-text-fill: #333333; -fx-font-size: 14px; -fx-cursor: hand;" text="👤  Quản lý Người dùng">
                    <padding>
                        <Insets bottom="12.0" left="15.0" right="15.0" top="12.0" />
                    </padding>
                </Button>

                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #333333; -fx-font-size: 14px; -fx-cursor: hand;" text="🔔  Thông báo">
                    <padding>
                        <Insets bottom="12.0" left="15.0" right="15.0" top="12.0" />
                    </padding>
                </Button>

                <Region VBox.vgrow="ALWAYS" />

                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleLogout" style="-fx-background-color: transparent; -fx-text-fill: #333333; -fx-font-size: 14px; -fx-cursor: hand;" text="🚪  Đăng xuất">
                    <padding>
                        <Insets bottom="12.0" left="15.0" right="15.0" top="12.0" />
                    </padding>
                </Button>
            </children>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #f0f2f5;" BorderPane.alignment="CENTER" />
    </center>

</BorderPane>